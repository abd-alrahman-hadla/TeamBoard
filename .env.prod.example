# Copy to .env.prod (gitignored) for docker-compose.prod.yml:
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build --wait
# Never commit the real .env.prod.

# Public origin of the stack (nginx). Used for CORS and the Origin check on /auth/refresh.
PUBLIC_ORIGIN=http://localhost:8090
# Host port nginx listens on.
PUBLIC_PORT=8090

# Bundled Postgres.
POSTGRES_USER=teamboard
POSTGRES_PASSWORD=change-me-to-a-long-random-password
POSTGRES_DB=teamboard

# At least 32 characters. Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-me-with-a-long-random-string-of-48-chars

# true when PUBLIC_ORIGIN is https (TLS in front of nginx); false for plain http://localhost.
COOKIE_SECURE=false

# API replicas behind nginx.
API_REPLICAS=2

# Requests per minute per IP on /auth/register and /auth/login.
AUTH_RATE_LIMIT=10
