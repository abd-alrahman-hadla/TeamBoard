# Copy to apps/api/.env and adjust. Never commit the real .env.
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Docker Compose Postgres (host port 5433, see docker-compose.yml)
DATABASE_URL=postgresql://teamboard:teamboard@localhost:5433/teamboard
# Used by the Jest integration tests (pnpm test:int). Optional: this is the default.
TEST_DATABASE_URL=postgresql://teamboard:teamboard@localhost:5433/teamboard_test

# The web app origin allowed by CORS and by the Origin check on /auth/refresh and /auth/logout
WEB_ORIGIN=http://localhost:3000

# At least 32 characters. Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-me-with-a-long-random-string-of-48-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7

# Cookies: set COOKIE_SECURE=true behind HTTPS. COOKIE_DOMAIN only when web and api are on sibling subdomains.
COOKIE_SECURE=false
COOKIE_DOMAIN=
# Path of the httpOnly refresh cookie. /auth when the API is served at the root; /api/auth behind
# a proxy that mounts it at /api (docker-compose.prod.yml, the Vercel rewrite).
REFRESH_COOKIE_PATH=/auth

# Requests per minute per IP on /auth/register and /auth/login (refresh/logout get 6x)
AUTH_RATE_LIMIT=10

# How long an invitation link stays valid
INVITATION_TTL_HOURS=48

# Realtime: Socket.io Redis adapter, required to run 2+ API instances (compose Redis on 6379).
# Leave empty for a single instance with the in-memory adapter.
REDIS_URL=redis://localhost:6379
# Reported to clients (hello event, X-Instance-Id header). Defaults to the hostname.
INSTANCE_ID=
# Set to true behind a reverse proxy (nginx) so req.ip is the client address.
TRUST_PROXY=false

# Serve Swagger UI at /docs and the spec at /docs-json
SWAGGER_ENABLED=true
