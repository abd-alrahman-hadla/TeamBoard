# Copy to apps/web/.env.local. NEXT_PUBLIC_* values are inlined at build time.
# Base URL of the TeamBoard API (apps/api). Its WEB_ORIGIN must be this app's origin (http://localhost:3000).
NEXT_PUBLIC_API_URL=http://localhost:4000
# A same-origin path also works (e.g. /api behind nginx or a Next.js rewrite).

# Optional: Socket.io server. Defaults to the API origin, or this page's origin when the API URL is a path.
# Set it when REST goes through a rewrite but sockets connect straight to the API (Vercel + Render).
NEXT_PUBLIC_SOCKET_URL=

# Public demo: show "Try the live demo" sign-in buttons on the login page (seed with pnpm db:seed:demo).
NEXT_PUBLIC_DEMO_MODE=false

# Server-side only (not NEXT_PUBLIC): when set, Next.js proxies /api/* to this API origin, so a
# deployment like Vercel serves REST same-origin (first-party cookies). Pair with NEXT_PUBLIC_API_URL=/api.
API_ORIGIN=
