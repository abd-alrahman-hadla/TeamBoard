{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "tasks": {
    "generate": {
      "inputs": ["prisma/schema.prisma", "prisma.config.ts"],
      "outputs": ["src/generated/**"]
    },
    "build": {
      "dependsOn": ["^build", "generate"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.test.*", "!**/*.spec.ts", "!**/*.int-spec.ts", "!e2e/**"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "dependsOn": ["^build", "generate"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build", "generate"]
    },
    "typecheck": {
      "dependsOn": ["^build", "generate"]
    },
    "test": {
      "dependsOn": ["^build", "generate"]
    },
    "test:int": {
      "dependsOn": ["^build", "generate"],
      "cache": false,
      "passThroughEnv": ["TEST_DATABASE_URL", "TEST_REDIS_URL"]
    },
    "e2e": {
      "dependsOn": ["^build", "@teamboard/api#build"],
      "cache": false,
      "passThroughEnv": ["E2E_DATABASE_URL", "CI"]
    }
  }
}
